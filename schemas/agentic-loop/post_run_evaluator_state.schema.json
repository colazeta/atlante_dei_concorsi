{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Post-run evaluator state",
  "type": "object",
  "required": [
    "evaluator_id",
    "status",
    "created_at_utc",
    "updated_at_utc",
    "repo",
    "scanned_issue_count",
    "scanned_issue_numbers",
    "continuation_needed_count",
    "evaluations"
  ],
  "properties": {
    "evaluator_id": {"type": "string"},
    "status": {"type": "string"},
    "created_at_utc": {"type": "string"},
    "updated_at_utc": {"type": "string"},
    "repo": {"type": "string"},
    "scanned_issue_count": {"type": "integer", "minimum": 0},
    "scanned_issue_numbers": {
      "type": "array",
      "items": {"type": "integer"}
    },
    "continuation_needed_count": {"type": "integer", "minimum": 0},
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue", "recommendation", "continuation_needed"],
        "properties": {
          "issue": {
            "type": "object",
            "required": ["number"],
            "properties": {"number": {"type": "integer"}}
          },
          "recommendation": {
            "type": "object",
            "required": ["action"],
            "properties": {
              "action": {"type": "string"},
              "next_label": {"type": ["string", "null"]}
            }
          },
          "continuation_needed": {"type": "boolean"}
        }
      }
    }
  }
}
