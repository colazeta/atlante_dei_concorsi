{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "committee_candidate_relation.schema.json",
  "title": "CommitteeCandidateRelation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relation_id",
    "procedure_id",
    "committee_member_person_id_or_name",
    "candidate_person_id_or_name",
    "relation_type",
    "relation_subtype",
    "evidence_source_type",
    "evidence_source_url",
    "evidence_document_id",
    "evidence_text_excerpt",
    "relation_start_date",
    "relation_end_date",
    "relation_recency",
    "relation_intensity",
    "confidence_level",
    "relation_relevant_for_review",
    "potential_conflict_review_signal",
    "human_review_required",
    "human_review_status",
    "publication_status"
  ],
  "properties": {
    "relation_id": { "type": "string" },
    "procedure_id": { "type": "string" },
    "committee_member_person_id_or_name": { "type": "string" },
    "candidate_person_id_or_name": { "type": "string" },
    "relation_type": {
      "type": "string",
      "enum": [
        "same_academic_field",
        "same_current_affiliation",
        "same_past_affiliation",
        "same_department_current",
        "same_department_past",
        "coauthorship_single",
        "coauthorship_recurrent",
        "coauthorship_recent",
        "shared_research_project",
        "shared_research_centre_or_lab",
        "supervisor_student_relation",
        "grant_or_project_hierarchy",
        "declared_abstention_or_challenge",
        "other_documented_relation",
        "no_relation_found",
        "not_determinable"
      ]
    },
    "relation_subtype": { "type": ["string", "null"] },
    "evidence_source_type": { "type": "string" },
    "evidence_source_url": { "type": "string", "format": "uri" },
    "evidence_document_id": { "type": ["string", "null"] },
    "evidence_text_excerpt": { "type": ["string", "null"] },
    "relation_start_date": { "type": ["string", "null"], "format": "date" },
    "relation_end_date": { "type": ["string", "null"], "format": "date" },
    "relation_recency": { "type": "string", "enum": ["current", "recent", "historical", "unknown"] },
    "relation_intensity": { "type": "string", "enum": ["weak", "medium", "strong", "not_determinable"] },
    "confidence_level": { "type": "string", "enum": ["low", "medium", "high"] },
    "relation_relevant_for_review": { "type": "boolean" },
    "potential_conflict_review_signal": { "type": "boolean" },
    "human_review_required": { "type": "boolean" },
    "human_review_status": {
      "type": "string",
      "enum": ["pending", "reviewed", "rejected", "confirmed_as_documented_relation"]
    },
    "publication_status": {
      "type": "string",
      "enum": ["internal_only", "publishable_summary", "publishable_full"]
    },
    "notes": { "type": ["string", "null"] }
  }
}
